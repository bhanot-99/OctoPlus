{
  "name": "rule_memory_pressure",
  "description": "memory_pressure fires after available memory holds at or below 10% for 2 minutes",
  "voice_available": false,
  "steps": [
    {
      "at_s": 0,
      "every_s": 30,
      "until_s": 150,
      "readings": [
        {
          "signal": "memory.available_percent",
          "key": "",
          "value": 8.0
        }
      ]
    }
  ],
  "expect": {
    "notified": [
      {
        "rule": "memory_pressure",
        "at_s": 120,
        "silent": false
      }
    ],
    "spoken": 0,
    "held_at_end": 0,
    "dropped": 0
  }
}
