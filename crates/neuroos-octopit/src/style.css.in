/* Generated into OUT_DIR by build.rs from ui/tokens/tokens.json. docs/design/octopit-ux.md §5. */
/*@COLORS@*/

window.octopit {
  background-color: @bg_canvas;
  color: @text_primary;
}

/* The desktop's own theme sets text colours on some containers: take them back so light and dark
   both read from our tokens. */
.card, .pill, .sidebar, .voice-dock, .status-strip, .toast, .bubble.assistant, .composer,
headerbar.octopit-header, headerbar.octopit-header label { color: @text_primary; }

/* ---- type ---- */
.num { font-feature-settings: "tnum" 1, "lnum" 1; }
.caption { font-size: 0.857em; color: @text_secondary; }
.muted { color: @text_muted; }
.title-page { font-size: 2em; font-weight: 700; letter-spacing: -0.01em; }
.title-section { font-size: 1.43em; font-weight: 600; }
.title-card { font-size: 0.929em; font-weight: 600; color: @text_secondary; letter-spacing: 0.06em; }
.metric { font-size: 2.857em; font-weight: 700; letter-spacing: -0.02em; }
.metric-unit { font-size: 1em; color: @text_secondary; font-weight: 500; }
.mono { font-family: monospace; font-size: 0.93em; }

/* ---- header ---- */
headerbar.octopit-header {
  background-color: @bg_canvas;
  background-image: none;
  border-bottom: 1px solid @border_subtle;
  box-shadow: none;
  min-height: 52px;
}
.brand { font-weight: 700; font-size: 1.07em; letter-spacing: 0.01em; }
.brand-mark { color: @accent_primary; }
.pill {
  border-radius: 999px;
  padding: 4px 14px 4px 10px;
  border: 1px solid @border_subtle;
  background-color: @bg_surface;
  font-weight: 500;
}
.pill.ok { border-color: alpha(@tier_safe, 0.5); }
.pill.degraded { border-color: alpha(@status_degraded, 0.6); }
.pill.down { border-color: alpha(@tier_dangerous, 0.6); }
.pill.loading { color: @text_secondary; }

/* ---- navigation ---- */
.sidebar {
  background-color: @bg_canvas;
  border-right: 1px solid @border_subtle;
  padding: 12px 8px;
}
.nav-item {
  border-radius: @RADIUS_MD@px;
  padding: 8px 12px;
  min-height: 24px;
  background: none;
  background-image: none;
  border: 1px solid transparent;
  color: @text_secondary;
  box-shadow: none;
  transition: background-color 120ms cubic-bezier(0.2, 0, 0, 1), color 120ms cubic-bezier(0.2, 0, 0, 1);
}
.nav-item:hover { background-color: @bg_surface; color: @text_primary; }
.nav-item.active {
  background-color: @bg_raised;
  border-color: @border_subtle;
  color: @text_primary;
  font-weight: 600;
}
.nav-item.active image { color: @accent_primary; }
.nav-item:focus-visible { outline: @FOCUS_W@px solid @accent_primary; outline-offset: @FOCUS_OFF@px; }

/* ---- surfaces ---- */
.page { padding: 24px 28px; }
.card {
  background-color: @bg_surface;
  border: 1px solid @border_subtle;
  border-radius: @RADIUS_LG@px;
  padding: 16px 18px;
  transition: border-color 120ms cubic-bezier(0.2, 0, 0, 1);
}
.card.raised { background-color: @bg_raised; }
.card.attention { border-color: alpha(@status_degraded, 0.7); }
.card.down { border-color: alpha(@tier_dangerous, 0.6); }
.card.clickable:hover { border-color: @border_strong; }
.hero { padding: 22px 24px; }
.hero.ok { border-color: alpha(@tier_safe, 0.45); }
.hero.degraded { border-color: alpha(@status_degraded, 0.6); }
.hero.down { border-color: alpha(@tier_dangerous, 0.6); }
.divider { background-color: @border_subtle; min-height: 1px; }

/* ---- status dots and text ---- */
.dot { border-radius: 999px; min-width: 10px; min-height: 10px; background-color: @text_muted; }
.dot.ok { background-color: @tier_safe; }
.dot.degraded { background-color: @status_degraded; }
.dot.down { background-color: @tier_dangerous; }
.dot.starting { background-color: @egress; }
.state-ok { color: @tier_safe; }
.state-degraded { color: @status_degraded; }
.state-down { color: @tier_dangerous; }
.state-starting { color: @egress; }

/* ---- bars ---- */
progressbar.slim trough { min-height: 6px; border-radius: 999px; background-color: @border_subtle; border: none; }
progressbar.slim progress { min-height: 6px; border-radius: 999px; background-color: @accent_primary; border: none; }
progressbar.slim.warn progress { background-color: @status_degraded; }
progressbar.slim.hot progress { background-color: @tier_dangerous; }

/* ---- chips ---- */
.chip {
  border-radius: @RADIUS_SM@px;
  padding: 1px 8px;
  font-size: 0.8em;
  font-weight: 600;
  letter-spacing: 0.06em;
  border: 1px solid @border_strong;
  color: @text_secondary;
}
.chip.external { color: @taint_external; border-color: @taint_external; }
.chip.web { color: @egress; border-color: @egress; }
.chip.warn { color: @status_degraded; border-color: @status_degraded; }
.chip.ok { color: @tier_safe; border-color: @tier_safe; }
.chip.down { color: @tier_dangerous; border-color: @tier_dangerous; }

/* ---- buttons ---- */
button.btn {
  border-radius: @RADIUS_MD@px;
  padding: 6px 14px;
  min-height: 24px;
  min-width: 24px;
  background-image: none;
  background-color: @bg_raised;
  color: @text_primary;
  border: 1px solid @border_strong;
  box-shadow: none;
}
button.btn:hover { border-color: @text_secondary; }
button.btn.primary { background-color: @accent_primary; color: @accent_primary_fg; border-color: @accent_primary; font-weight: 600; }
button.btn.flat { background-color: transparent; border-color: transparent; color: @text_secondary; }
button.btn.flat:hover { background-color: @bg_surface; color: @text_primary; }
button.btn:disabled { opacity: 0.45; }
button.btn:focus-visible, entry:focus-within, textview:focus-within {
  outline: @FOCUS_W@px solid @accent_primary;
  outline-offset: @FOCUS_OFF@px;
}

/* ---- chat ---- */
.bubble { border-radius: @RADIUS_LG@px; padding: 10px 14px; }
.bubble.user { background-color: @accent_primary; color: @accent_primary_fg; border-bottom-right-radius: @RADIUS_SM@px; }
.bubble.assistant { background-color: @bg_surface; border: 1px solid @border_subtle; border-bottom-left-radius: @RADIUS_SM@px; }
.bubble.assistant.failed { border-color: alpha(@tier_dangerous, 0.6); }
.bubble.assistant.external { border-left: 4px solid @taint_external; }
.composer {
  background-color: @bg_surface;
  border: 1px solid @border_strong;
  border-radius: @RADIUS_LG@px;
  padding: 6px 8px 6px 14px;
}
.composer textview, .composer textview text { background-color: transparent; color: @text_primary; }
.composer:focus-within { border-color: @accent_primary; }
.example-prompt { border-radius: @RADIUS_MD@px; padding: 10px 14px; background-color: @bg_surface; border: 1px solid @border_subtle; color: @text_secondary; }
.example-prompt:hover { border-color: @border_strong; color: @text_primary; }

/* ---- voice dock ---- */
.voice-dock {
  background-color: @bg_canvas;
  border-left: 1px solid @border_subtle;
  padding: 20px 16px;
}
.mic-button {
  border-radius: 999px;
  min-width: 84px;
  min-height: 84px;
  padding: 0;
  background-image: none;
  background-color: @bg_raised;
  color: @text_primary;
  border: 2px solid @border_strong;
  box-shadow: none;
  transition: background-color 200ms cubic-bezier(0.2, 0, 0, 1), border-color 200ms cubic-bezier(0.2, 0, 0, 1);
}
.mic-button image { -gtk-icon-size: 32px; }
.mic-button:hover { border-color: @accent_primary; }
.mic-button.idle { border-color: alpha(@accent_primary, 0.7); }
.mic-button.followup { border-color: @accent_primary; }
.mic-button.listening, .mic-button.speaking { background-color: @accent_primary; color: @accent_primary_fg; border-color: @accent_primary; }
.mic-button.thinking { border-color: @accent_primary; }
.mic-button.off, .mic-button.unavailable { color: @text_muted; border-color: @border_subtle; }
.mic-button.busy { border-color: @status_degraded; color: @status_degraded; }
.mic-button:focus-visible { outline: @FOCUS_W@px solid @accent_primary; outline-offset: 4px; }
.mic-halo { border-radius: 999px; min-width: 120px; min-height: 120px; }
.voice-label { font-weight: 600; }
.transcript { color: @text_secondary; font-style: italic; }

window.octopit:not(.reduce-motion) .mic-button.listening { animation: octopit-pulse 1600ms cubic-bezier(0.2, 0, 0, 1) infinite; }
window.octopit:not(.reduce-motion) .mic-button.thinking { animation: octopit-breathe 1400ms ease-in-out infinite; }
@keyframes octopit-pulse {
  0% { box-shadow: 0 0 0 0 alpha(@accent_primary, 0.55); }
  100% { box-shadow: 0 0 0 22px alpha(@accent_primary, 0); }
}
@keyframes octopit-breathe {
  0% { border-color: alpha(@accent_primary, 0.25); }
  50% { border-color: @accent_primary; }
  100% { border-color: alpha(@accent_primary, 0.25); }
}

/* ---- status strip ---- */
.status-strip { background-color: @bg_canvas; border-top: 1px solid @border_subtle; padding: 4px 12px; }
.status-fact { padding: 4px 10px; border-radius: @RADIUS_SM@px; background: none; background-image: none; border: 1px solid transparent; color: @text_secondary; box-shadow: none; min-height: 20px; }
.status-fact:hover { background-color: @bg_surface; color: @text_primary; }
.status-fact:focus-visible { outline: @FOCUS_W@px solid @accent_primary; outline-offset: 0; }

/* ---- toast ---- */
.toast { background-color: @bg_raised; border: 1px solid @border_strong; border-radius: @RADIUS_MD@px; padding: 8px 14px; }

/* ---- lists ---- */
.row-line { padding: 8px 0; border-bottom: 1px solid @border_subtle; }
.skeleton { background-color: @border_subtle; border-radius: @RADIUS_SM@px; min-height: 14px; }

/* ---- drawn widgets take their colour from `color` ---- */
.spark, .ring { color: @accent_primary; }
.spark.warn, .ring.warn { color: @status_degraded; }
.spark.hot, .ring.hot { color: @tier_dangerous; }

/* ---- chat (agy) ---- */
.chat-empty {
  padding: 48px 16px;
}
.chat-example-box {
  margin-top: 16px;
}
.composer textview {
  min-height: 24px;
}
.composer textview:focus-within, .composer textview:focus { outline: none; }

