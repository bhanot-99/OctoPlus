/* Generated into OUT_DIR by build.rs from ui/tokens/tokens.json (the `octopit` section, @oct_*).
   OctoPit v2 visual language: docs/design/octopit-ux.md §10. Light first, dark supported.
   Rules: colours only from tokens; state is never colour alone; radii 24 (card), 16 (tile), 10 (chip), pill. */
/*@COLORS@*/

window.octopit {
  background-color: @oct_canvas;
  color: @oct_text;
}

/* The desktop's own theme sets text colours on some containers: take them back. */
.card, .tile, .pill, .tab, .rail, .toast, .bubble.assistant, .composer, .fab-pill,
headerbar.octopit-header, headerbar.octopit-header label { color: @oct_text; }

/* ---- type ---- */
.num { font-feature-settings: "tnum" 1, "lnum" 1; }
.caption { font-size: 0.857em; color: @oct_text2; }
.muted { color: @oct_text3; }
.title-page { font-size: 2.14em; font-weight: 700; letter-spacing: -0.02em; }
.title-greet { color: @oct_text2; }
.title-section { font-size: 1.21em; font-weight: 650; letter-spacing: -0.01em; }
.title-card { font-size: 0.8em; font-weight: 650; color: @oct_text2; letter-spacing: 0.08em; }
.metric { font-size: 2.43em; font-weight: 700; letter-spacing: -0.03em; }
.metric-md { font-size: 1.64em; font-weight: 700; letter-spacing: -0.02em; }
.metric-unit { color: @oct_text2; font-weight: 500; }
.mono { font-family: monospace; font-size: 0.93em; }

/* ---- top bar and navigation ---- */
headerbar.octopit-header {
  background-color: @oct_canvas;
  background-image: none;
  border-bottom: none;
  box-shadow: none;
  min-height: 64px;
  padding: 0 12px;
}
.brand { font-weight: 800; font-size: 1.14em; letter-spacing: -0.01em; }
.tab {
  border-radius: 999px;
  padding: 7px 16px;
  min-height: 20px;
  background: @oct_surface;
  background-image: none;
  border: 1px solid transparent;
  color: @oct_text2;
  font-weight: 600;
  box-shadow: 0 1px 2px rgba(16, 24, 40, 0.05);
  transition: background-color 140ms cubic-bezier(0.2, 0, 0, 1), color 140ms cubic-bezier(0.2, 0, 0, 1);
}
.tab:hover { color: @oct_text; border-color: @oct_border; }
.tab.active { background: @oct_ink; color: @oct_ink_fg; }
.tab label { color: inherit; }
.tab.active image, .tab.active label { color: @oct_ink_fg; }
.tab:focus-visible, .rail-btn:focus-visible, .search-pill:focus-visible { outline: 2px solid @oct_a; outline-offset: 2px; }
.search-pill {
  border-radius: 999px;
  padding: 7px 16px;
  background: @oct_surface;
  background-image: none;
  border: 1px solid transparent;
  color: @oct_text3;
  box-shadow: 0 1px 2px rgba(16, 24, 40, 0.05);
}
.search-pill:hover { color: @oct_text; border-color: @oct_border; }
.pill {
  border-radius: 999px;
  padding: 6px 14px 6px 10px;
  background: @oct_surface;
  border: 1px solid transparent;
  font-weight: 600;
  box-shadow: 0 1px 2px rgba(16, 24, 40, 0.05);
}
.pill.ok { background: @oct_ok_soft; }
.pill.ok label { color: @oct_ok; }
.pill.degraded { background: @oct_warn_soft; }
.pill.degraded label { color: @oct_warn; }
.pill.down { background: @oct_bad_soft; }
.pill.down label { color: @oct_bad; }
.pill.loading label { color: @oct_text2; }
.avatar {
  border-radius: 999px;
  min-width: 38px;
  min-height: 38px;
  padding: 0;
  background-image: linear-gradient(135deg, @oct_a, @oct_b);
  color: #FFFFFF;
  border: 2px solid @oct_surface;
  box-shadow: 0 2px 8px rgba(16, 24, 40, 0.12);
}

/* left rail: a vertical pill of round icon buttons */
.rail {
  background: @oct_surface;
  border-radius: 999px;
  padding: 8px 6px;
  box-shadow: 0 1px 2px rgba(16, 24, 40, 0.05);
}
.rail-btn {
  border-radius: 999px;
  min-width: 36px;
  min-height: 36px;
  padding: 0;
  background: transparent;
  background-image: none;
  border: none;
  color: @oct_text2;
  box-shadow: none;
}
.rail-btn:hover { background: @oct_surface_soft; color: @oct_text; }
.rail-btn.active { background: @oct_ink; color: @oct_ink_fg; }
.rail-btn.active image { color: @oct_ink_fg; }

/* ---- surfaces ---- */
.page { padding: 8px 28px 28px 8px; }
.card {
  background-color: @oct_surface;
  border: 1px solid alpha(@oct_border, 0.6);
  border-radius: 24px;
  padding: 20px 22px;
  box-shadow: 0 8px 28px rgba(16, 24, 40, 0.05), 0 1px 2px rgba(16, 24, 40, 0.04);
  transition: box-shadow 160ms cubic-bezier(0.2, 0, 0, 1);
}
.card.raised { background-color: @oct_surface; }
.card.attention { border-color: alpha(@oct_warn, 0.5); }
.card.down { border-color: alpha(@oct_bad, 0.45); }
.card.clickable:hover { box-shadow: 0 12px 34px rgba(16, 24, 40, 0.09); }
.tile { background-color: @oct_surface_soft; border-radius: 16px; padding: 12px 14px; }
.hero { padding: 22px 24px; }
.hero.ok { background-image: linear-gradient(135deg, @oct_surface, @oct_ok_soft); }
.hero.degraded { background-image: linear-gradient(135deg, @oct_surface, @oct_warn_soft); }
.hero.down { background-image: linear-gradient(135deg, @oct_surface, @oct_bad_soft); }
.divider { background-color: @oct_border; min-height: 1px; }

/* iridescent gradient cards (the voice card, the orb card) */
.gradient-card {
  border-radius: 24px;
  padding: 20px 22px;
  background-image:
    radial-gradient(circle at 15% 10%, alpha(@oct_c, 0.95), alpha(@oct_c, 0) 55%),
    radial-gradient(circle at 90% 20%, alpha(@oct_d, 0.9), alpha(@oct_d, 0) 55%),
    linear-gradient(135deg, @oct_a, @oct_b);
  box-shadow: 0 14px 34px alpha(@oct_a, 0.35);
}
.gradient-card label { color: #FFFFFF; }
.gradient-card .caption { color: rgba(255, 255, 255, 0.88); }

/* ---- status dots and words (state is never colour alone) ---- */
.dot { border-radius: 999px; min-width: 10px; min-height: 10px; background-color: @oct_text3; }
.dot.ok { background-color: @oct_ok; }
.dot.degraded { background-color: @oct_warn; }
.dot.down { background-color: @oct_bad; }
.dot.starting { background-color: @oct_egress; }
.state-ok { color: @oct_ok; }
.state-degraded { color: @oct_warn; }
.state-down { color: @oct_bad; }
.state-starting { color: @oct_egress; }

/* ---- bars ---- */
progressbar.slim trough { min-height: 8px; min-width: 0; border-radius: 999px; background-color: @oct_surface_soft; border: none; }
progressbar.slim progress { min-height: 8px; min-width: 0; margin: 0; border-radius: 999px; border: none; background-image: linear-gradient(90deg, @oct_a, @oct_b); }
progressbar.slim.warn progress { background-image: linear-gradient(90deg, @oct_c, @oct_warn); }
progressbar.slim.hot progress { background-image: linear-gradient(90deg, @oct_b, @oct_bad); }

/* ---- chips and segmented controls ---- */
.chip {
  border-radius: 10px;
  padding: 2px 9px;
  font-size: 0.78em;
  font-weight: 700;
  letter-spacing: 0.05em;
  background: @oct_surface_soft;
  color: @oct_text2;
}
.chip.external { background: alpha(@oct_taint, 0.12); color: @oct_taint; }
.chip.web { background: @oct_egress_soft; color: @oct_egress; }
.chip.warn { background: @oct_warn_soft; color: @oct_warn; }
.chip.ok { background: @oct_ok_soft; color: @oct_ok; }
.chip.down { background: @oct_bad_soft; color: @oct_bad; }
.seg { background: @oct_surface_soft; border-radius: 999px; padding: 3px; }
.seg button, .seg togglebutton {
  border-radius: 999px;
  padding: 5px 14px;
  min-height: 18px;
  background: transparent;
  background-image: none;
  border: none;
  box-shadow: none;
  color: @oct_text2;
  font-weight: 600;
}
.seg button:checked, .seg togglebutton:checked, .seg button.active { background: @oct_surface; color: @oct_text; box-shadow: 0 1px 4px rgba(16, 24, 40, 0.12); }
.seg button:focus-visible, .seg togglebutton:focus-visible { outline: 2px solid @oct_a; outline-offset: 1px; }

/* ---- buttons ---- */
button.btn {
  border-radius: 999px;
  padding: 7px 18px;
  min-height: 20px;
  min-width: 24px;
  background-image: none;
  background-color: @oct_surface;
  color: @oct_text;
  border: 1px solid @oct_border;
  box-shadow: none;
  font-weight: 600;
}
button.btn:hover { border-color: @oct_border_strong; }
button.btn.primary { background-color: @oct_ink; color: @oct_ink_fg; border-color: @oct_ink; }
button.btn.flat { background-color: transparent; border-color: transparent; color: @oct_text2; }
button.btn.flat:hover { background-color: @oct_surface_soft; color: @oct_text; }
button.btn:disabled { opacity: 0.45; }
button.btn:focus-visible, entry:focus-within, textview:focus-within { outline: 2px solid @oct_a; outline-offset: 2px; }
togglebutton.btn:checked, button.btn:checked { background-color: @oct_ink; color: @oct_ink_fg; border-color: @oct_ink; }
switch { background-color: @oct_border_strong; border: none; border-radius: 999px; }
switch:checked { background-image: linear-gradient(90deg, @oct_a, @oct_b); }
switch slider { background-color: #FFFFFF; border-color: transparent; border-radius: 999px; }

/* ---- chat ---- */
.bubble { border-radius: 20px; padding: 11px 16px; }
.bubble.user { background-image: linear-gradient(135deg, @oct_a, @oct_b); border-bottom-right-radius: 6px; }
.bubble.user label { color: #FFFFFF; }
.bubble.assistant { background-color: @oct_surface; border: 1px solid @oct_border; border-bottom-left-radius: 6px; box-shadow: 0 2px 8px rgba(16, 24, 40, 0.04); }
.bubble.assistant.failed { border-color: alpha(@oct_bad, 0.5); }
.bubble.assistant.external { border-left: 4px solid @oct_taint; }
.composer {
  background-color: @oct_surface;
  border: 1px solid @oct_border;
  border-radius: 24px;
  padding: 8px 10px 8px 18px;
  box-shadow: 0 8px 28px rgba(16, 24, 40, 0.06);
}
.composer textview, .composer textview text { background-color: transparent; color: @oct_text; }
.composer:focus-within { border-color: @oct_a; }
.composer textview { min-height: 24px; }
.composer textview:focus-within, .composer textview:focus { outline: none; }
.chat-empty { padding: 48px 16px; }
.chat-example-box { margin-top: 16px; }
.example-prompt { border-radius: 999px; padding: 10px 18px; background-color: @oct_surface; border: 1px solid @oct_border; color: @oct_text2; font-weight: 600; box-shadow: 0 1px 2px rgba(16, 24, 40, 0.04); }
.example-prompt:hover { border-color: @oct_a; color: @oct_text; }

/* ---- the mic: the floating button and the big voice card ---- */
.mic-button {
  border-radius: 999px;
  min-width: 84px;
  min-height: 84px;
  padding: 0;
  background-image: none;
  background-color: @oct_surface;
  color: @oct_text;
  border: none;
  box-shadow: 0 10px 28px rgba(16, 24, 40, 0.18);
  transition: background-color 200ms cubic-bezier(0.2, 0, 0, 1), box-shadow 200ms cubic-bezier(0.2, 0, 0, 1);
}
.mic-button image { -gtk-icon-size: 32px; }
.mic-button:hover { box-shadow: 0 14px 32px rgba(16, 24, 40, 0.26); }
.mic-button.fab { min-width: 60px; min-height: 60px; background-color: @oct_ink; color: @oct_ink_fg; }
.mic-button.fab image { -gtk-icon-size: 24px; }
.mic-button.listening, .mic-button.speaking { background-image: linear-gradient(135deg, @oct_a, @oct_b); background-color: @oct_a; color: #FFFFFF; }
.mic-button.thinking { color: @oct_a; }
.mic-button.off, .mic-button.unavailable { color: @oct_text3; box-shadow: none; }
.mic-button.busy { color: @oct_warn; }
.mic-button:focus-visible { outline: 3px solid @oct_a; outline-offset: 4px; }
.mic-halo { border-radius: 999px; min-width: 120px; min-height: 120px; }
.voice-label { font-weight: 700; }
.fab-pill { border-radius: 999px; padding: 6px 14px; background: @oct_surface; box-shadow: 0 6px 20px rgba(16, 24, 40, 0.14); font-weight: 600; }

window.octopit:not(.reduce-motion) .mic-button.listening { animation: octopit-pulse 1600ms cubic-bezier(0.2, 0, 0, 1) infinite; }
window.octopit:not(.reduce-motion) .mic-button.thinking { animation: octopit-breathe 1400ms ease-in-out infinite; }
@keyframes octopit-pulse {
  0% { box-shadow: 0 0 0 0 alpha(@oct_a, 0.55); }
  100% { box-shadow: 0 0 0 24px alpha(@oct_a, 0); }
}
@keyframes octopit-breathe {
  0% { box-shadow: 0 0 0 0 alpha(@oct_a, 0); }
  50% { box-shadow: 0 0 0 10px alpha(@oct_a, 0.28); }
  100% { box-shadow: 0 0 0 0 alpha(@oct_a, 0); }
}

/* ---- status strip ---- */
.status-strip { background: transparent; padding: 4px 16px 10px 16px; }
.status-fact { padding: 4px 12px; border-radius: 999px; background: transparent; background-image: none; border: none; color: @oct_text2; box-shadow: none; min-height: 20px; }
.status-fact:hover { background-color: @oct_surface; color: @oct_text; }
.status-fact:focus-visible { outline: 2px solid @oct_a; outline-offset: 0; }

/* ---- toast, lists, skeleton ---- */
.toast { background-color: @oct_ink; border-radius: 999px; padding: 10px 20px; box-shadow: 0 10px 28px rgba(16, 24, 40, 0.25); }
.toast label { color: @oct_ink_fg; }
.row-line { padding: 10px 0; border-bottom: 1px solid @oct_surface_soft; }
.skeleton { background-color: @oct_surface_soft; border-radius: 10px; min-height: 14px; }
.badge-icon { background: @oct_surface_soft; border-radius: 999px; min-width: 36px; min-height: 36px; }
.legend-dot { border-radius: 999px; min-width: 9px; min-height: 9px; }

/* ---- drawn widgets take their colour from `color` ---- */
.spark, .ring { color: @oct_a; }
.spark.warn, .ring.warn { color: @oct_warn; }
.spark.hot, .ring.hot { color: @oct_bad; }

/* ---- page-specific spacing ---- */
.backend-card { min-height: 140px; }
.gpu-gauges { margin: 12px 0; }
.gpu-gauge-col { padding: 8px; }
.gpu-spark-row { margin-top: 12px; }
.audit-row { min-height: 28px; }
.audit-time, .ledger-time { min-width: 60px; }
.bullet-dot { min-width: 16px; }
.settings-group { margin-bottom: 8px; }
.settings-row { margin-top: 8px; }

/* ---- palette and welcome windows ---- */
window.octopit list { background-color: transparent; color: @oct_text; }
window.octopit list row { border-radius: 14px; }
window.octopit list row:selected { background-color: @oct_surface_soft; color: @oct_text; outline: 2px solid @oct_a; outline-offset: -2px; }
window.octopit entry { background-color: @oct_surface; color: @oct_text; border: 1px solid @oct_border; border-radius: 999px; padding: 6px 14px; }
.palette-window { padding: 14px; }
.palette-search { margin-bottom: 8px; }
.palette-list { background-color: transparent; }
.palette-row { padding: 8px 12px; border-radius: 14px; }
.welcome-window { padding: 24px; }
.welcome-step { padding: 16px 24px; }

/* ---- narrow windows ---- */
window.compact .metric { font-size: 1.8em; }
window.compact .page { padding: 4px 14px 20px 14px; }
window.compact .title-page { font-size: 1.7em; }
window.compact .card { padding: 14px 14px; }
window.compact .hero { padding: 14px 14px; }
window.compact .tab { padding: 6px 10px; }

/* ---- charts (agy) ---- */
.series-0 { background-color: @oct_a; }
.series-1 { background-color: @oct_b; }
.series-2 { background-color: @oct_c; }
.series-3 { background-color: @oct_d; }
.series-4 { background-color: @oct_ok; }
.series-5 { background-color: @oct_ok; }
.series-6 { background-color: @oct_warn; }
.series-7 { background-color: @oct_text3; }

/* ---- backends and activity (agy) ---- */
.gpu-gauges .tile { padding: 12px 10px; }

