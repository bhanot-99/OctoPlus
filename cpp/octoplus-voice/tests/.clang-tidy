# Tests only (same relaxations as liboctoplus/tests): GoogleTest macros inflate complexity and
# guard optionals with ASSERT in ways the analyser cannot see; fixtures expose members by design.
# Plus what audio tests do on purpose: fixed random seeds (reproducible failures), float time
# loops for synthetic tones, small C arrays of test data and the C varargs of printf-style output.
# Library code keeps the full rule set from the repository root.
InheritParentConfig: true
Checks: >
  -readability-function-cognitive-complexity,
  -bugprone-unchecked-optional-access,
  -cppcoreguidelines-non-private-member-variables-in-classes,
  -cppcoreguidelines-owning-memory,
  -cppcoreguidelines-pro-type-reinterpret-cast,
  -cppcoreguidelines-pro-type-vararg,
  -cppcoreguidelines-avoid-c-arrays,
  -modernize-avoid-c-arrays,
  -cppcoreguidelines-pro-bounds-array-to-pointer-decay,
  -cppcoreguidelines-pro-bounds-constant-array-index,
  -bugprone-implicit-widening-of-multiplication-result,
  -cert-err33-c,
  -cert-msc32-c,
  -cert-msc51-cpp,
  -cert-flp30-c,
  -clang-analyzer-security.FloatLoopCounter,
  -concurrency-mt-unsafe,
  -modernize-use-std-numbers,
  -misc-use-anonymous-namespace
