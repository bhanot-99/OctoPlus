{
  "version": 6,
  "cmakeMinimumRequired": { "major": 3, "minor": 28, "patch": 0 },
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "cacheVariables": { "CMAKE_CXX_COMPILER": "g++" }
    },
    { "name": "debug", "inherits": "base", "cacheVariables": { "CMAKE_BUILD_TYPE": "Debug", "OCTOPLUS_WITH_LLAMA": "ON" } },
    { "name": "release", "inherits": "base", "cacheVariables": { "CMAKE_BUILD_TYPE": "Release", "OCTOPLUS_WITH_LLAMA": "ON" } },
    { "name": "voice", "inherits": "base", "cacheVariables": { "CMAKE_BUILD_TYPE": "Debug", "OCTOPLUS_WITH_LLAMA": "OFF", "OCTOPLUS_WITH_VOICE_ENGINES": "ON" } },
    { "name": "voice-release", "inherits": "base", "cacheVariables": { "CMAKE_BUILD_TYPE": "Release", "OCTOPLUS_WITH_LLAMA": "OFF", "OCTOPLUS_WITH_VOICE_ENGINES": "ON" } },
    {
      "name": "asan", "inherits": "base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "OCTOPLUS_WITH_LLAMA": "OFF",
        "CMAKE_CXX_FLAGS": "-fsanitize=address,undefined -fno-omit-frame-pointer -fno-sanitize-recover=all"
      }
    },
    {
      "name": "tsan", "inherits": "base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "OCTOPLUS_WITH_LLAMA": "OFF",
        "CMAKE_CXX_FLAGS": "-fsanitize=thread -fno-omit-frame-pointer",
        "CMAKE_CROSSCOMPILING_EMULATOR": "setarch;x86_64;-R"
      }
    },
    {
      "name": "coverage", "inherits": "base",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Debug", "OCTOPLUS_WITH_LLAMA": "OFF", "OCTOPLUS_COVERAGE": "ON" }
    }
  ],
  "buildPresets": [
    { "name": "debug", "configurePreset": "debug" },
    { "name": "release", "configurePreset": "release" },
    { "name": "voice", "configurePreset": "voice" },
    { "name": "voice-release", "configurePreset": "voice-release" },
    { "name": "asan", "configurePreset": "asan" },
    { "name": "tsan", "configurePreset": "tsan" },
    { "name": "coverage", "configurePreset": "coverage" }
  ],
  "testPresets": [
    { "name": "debug", "configurePreset": "debug", "output": { "outputOnFailure": true } },
    { "name": "release", "configurePreset": "release", "output": { "outputOnFailure": true } },
    { "name": "voice", "configurePreset": "voice", "output": { "outputOnFailure": true } },
    { "name": "voice-release", "configurePreset": "voice-release", "output": { "outputOnFailure": true } },
    { "name": "asan", "configurePreset": "asan", "output": { "outputOnFailure": true } },
    { "name": "tsan", "configurePreset": "tsan", "output": { "outputOnFailure": true } },
    { "name": "coverage", "configurePreset": "coverage", "output": { "outputOnFailure": true } }
  ]
}
