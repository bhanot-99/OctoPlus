[Unit]
Description=Semantic-NeuroOS LLM Inference Service
PartOf=neuroos.target
Requires=neuroos-runtime.service
After=neuroos-runtime.service neuroos-healthd.service

[Service]
PrivateNetwork=true
InaccessiblePaths=-/run/systemd/resolve
InaccessiblePaths=-/run/dbus/system_bus_socket
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=tmpfs
BindReadOnlyPaths=%h/.local/opt/neuroos
BindReadOnlyPaths=-%h/.config/neuroos/config.toml
InaccessiblePaths=-/run/neuroos-fetcher
TemporaryFileSystem=%t/neuroos
BindPaths=%t/neuroos/inference
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectClock=true
ProtectHostname=true
RestrictNamespaces=true
RestrictRealtime=true
RestrictSUIDSGID=true
RestrictAddressFamilies=AF_UNIX
LockPersonality=true
MemoryDenyWriteExecute=true
SystemCallArchitectures=native
SystemCallFilter=@system-service landlock_create_ruleset landlock_add_rule landlock_restrict_self
CapabilityBoundingSet=
AmbientCapabilities=
LimitCORE=0
UMask=0077
MemoryMax=3220M
Restart=on-failure
RestartSec=2s
ExecStartPre=/usr/bin/sha256sum --check --quiet %h/.local/opt/neuroos/models/SHA256SUMS
ExecStart=%h/.local/opt/neuroos/bin/neuroos-inference --socket %t/neuroos/inference/inference/inference.sock=neuroos-knowledge.service --health-socket %t/neuroos/inference/health/health.sock=neuroos-healthd.service --model %h/.local/opt/neuroos/models/llm/Qwen3-4B-Instruct-2507-Q4_K_M.gguf --threads 8 --ctx 2048 --batch 512

[Install]
WantedBy=neuroos.target
