[Unit]
Description=Semantic-NeuroOS Health Daemon
PartOf=neuroos.target
Requires=neuroos-runtime.service
After=neuroos-runtime.service

[Service]
PrivateNetwork=true
InaccessiblePaths=-/run/systemd/resolve
InaccessiblePaths=-/run/dbus/system_bus_socket
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=tmpfs
BindReadOnlyPaths=%h/.local/opt/neuroos
BindReadOnlyPaths=-%h/.config/neuroos/config.toml
BindPaths=%h/.local/share/neuroos/soak
InaccessiblePaths=-/run/neuroos-fetcher/fetch
BindPaths=-/run/neuroos-fetcher/health
TemporaryFileSystem=%t/neuroos
BindPaths=%t/neuroos/healthd
BindPaths=%t/neuroos/monitor/health
BindPaths=%t/neuroos/voice/health
BindPaths=%t/neuroos/storage/health
BindPaths=%t/neuroos/inference/health
BindPaths=%t/neuroos/knowledge/health
BindPaths=%t/neuroos/kernel/health
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectClock=true
ProtectHostname=true
RestrictNamespaces=true
RestrictRealtime=true
RestrictSUIDSGID=true
RestrictAddressFamilies=AF_UNIX
LockPersonality=true
MemoryDenyWriteExecute=true
SystemCallArchitectures=native
SystemCallFilter=@system-service landlock_create_ruleset landlock_add_rule landlock_restrict_self
CapabilityBoundingSet=
AmbientCapabilities=
LimitCORE=0
UMask=0077
MemoryMax=32M
Restart=on-failure
RestartSec=2s
ExecStart=%h/.local/opt/neuroos/bin/neuroos-healthd

[Install]
WantedBy=neuroos.target
