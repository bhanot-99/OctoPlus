[Unit]
Description=Semantic-NeuroOS speech helper socket (Pocket TTS, temporary exception D-54)

[Socket]
# The only way in. C2 connects here; nothing is ever exposed on the host network (the helper and
# its relay share one private network namespace, see neuroos-tts-proxy.service).
ListenStream=%t/neuroos/tts/tts.sock
DirectoryMode=0700
SocketMode=0600
Accept=no

[Install]
WantedBy=sockets.target
