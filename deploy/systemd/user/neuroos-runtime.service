[Unit]
Description=Semantic-NeuroOS Runtime Directories
PartOf=neuroos.target

[Service]
Type=oneshot
RemainAfterExit=yes
PrivateNetwork=true
InaccessiblePaths=-/run/systemd/resolve
InaccessiblePaths=-/run/dbus/system_bus_socket
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=tmpfs
BindPaths=%t
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectClock=true
ProtectHostname=true
RestrictNamespaces=true
RestrictRealtime=true
RestrictSUIDSGID=true
RestrictAddressFamilies=AF_UNIX
LockPersonality=true
MemoryDenyWriteExecute=true
SystemCallArchitectures=native
SystemCallFilter=@system-service
CapabilityBoundingSet=
AmbientCapabilities=
LimitCORE=0
UMask=0077
ExecStart=/usr/bin/install -d -m 0700 %t/neuroos
ExecStart=/usr/bin/install -d -m 0700 %t/neuroos/monitor %t/neuroos/voice %t/neuroos/storage %t/neuroos/inference %t/neuroos/knowledge %t/neuroos/kernel %t/neuroos/healthd
ExecStart=/usr/bin/install -d -m 0700 %t/neuroos/monitor/stream %t/neuroos/monitor/control %t/neuroos/monitor/health
ExecStart=/usr/bin/install -d -m 0700 %t/neuroos/voice/voice %t/neuroos/voice/control %t/neuroos/voice/health
ExecStart=/usr/bin/install -d -m 0700 %t/neuroos/storage/storage %t/neuroos/storage/health
ExecStart=/usr/bin/install -d -m 0700 %t/neuroos/inference/inference %t/neuroos/inference/health
ExecStart=/usr/bin/install -d -m 0700 %t/neuroos/knowledge/knowledge %t/neuroos/knowledge/health
ExecStart=/usr/bin/install -d -m 0700 %t/neuroos/kernel/kernel %t/neuroos/kernel/health
ExecStart=/usr/bin/install -d -m 0700 %t/neuroos/healthd/healthd

[Install]
WantedBy=neuroos.target
