[Unit]
Description=Semantic-NeuroOS Runtime Directories
PartOf=neuroos.target

[Service]
Type=oneshot
RemainAfterExit=yes
PrivateNetwork=true
InaccessiblePaths=-/run/systemd/resolve
InaccessiblePaths=-/run/dbus/system_bus_socket
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=tmpfs
BindPaths=%t
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectClock=true
ProtectHostname=true
RestrictNamespaces=true
RestrictRealtime=true
RestrictSUIDSGID=true
RestrictAddressFamilies=AF_UNIX
LockPersonality=true
MemoryDenyWriteExecute=true
SystemCallArchitectures=native
SystemCallFilter=@system-service
CapabilityBoundingSet=
AmbientCapabilities=
LimitCORE=0
UMask=0077
ExecStart=/usr/bin/install -d -m 0700 %t/neuroos %t/neuroos/monitor %t/neuroos/voice %t/neuroos/storage %t/neuroos/inference %t/neuroos/knowledge %t/neuroos/kernel %t/neuroos/healthd %t/neuroos/monitor/stream %t/neuroos/monitor/control %t/neuroos/voice/voice %t/neuroos/voice/control %t/neuroos/storage/storage %t/neuroos/inference/inference %t/neuroos/knowledge/knowledge %t/neuroos/kernel/kernel %t/neuroos/healthd/healthd %t/neuroos/monitor/health %t/neuroos/voice/health %t/neuroos/storage/health %t/neuroos/inference/health %t/neuroos/knowledge/health %t/neuroos/kernel/health

[Install]
WantedBy=neuroos.target
