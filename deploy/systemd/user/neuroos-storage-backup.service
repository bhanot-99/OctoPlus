[Unit]
Description=Semantic-NeuroOS storage job: backup
After=neuroos-storage.service

[Service]
Type=oneshot
PrivateNetwork=true
InaccessiblePaths=-/run/systemd/resolve
InaccessiblePaths=-/run/dbus/system_bus_socket
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=tmpfs
BindReadOnlyPaths=%h/.local/opt/neuroos
InaccessiblePaths=-/run/neuroos-fetcher
TemporaryFileSystem=%t/neuroos
BindPaths=%t/neuroos/storage/storage
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectClock=true
ProtectHostname=true
RestrictNamespaces=true
RestrictRealtime=true
RestrictSUIDSGID=true
RestrictAddressFamilies=AF_UNIX
LockPersonality=true
MemoryDenyWriteExecute=true
SystemCallArchitectures=native
SystemCallFilter=@system-service
CapabilityBoundingSet=
AmbientCapabilities=
LimitCORE=0
UMask=0077
MemoryMax=32M
ExecStart=%h/.local/opt/neuroos/bin/neuroosctl --runtime-dir %t/neuroos storage job backup
