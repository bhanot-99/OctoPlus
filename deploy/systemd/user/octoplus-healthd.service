[Unit]
Description=OctoPlus Health Daemon
PartOf=octoplus.target
Requires=octoplus-runtime.service
After=octoplus-runtime.service

[Service]
PrivateNetwork=true
InaccessiblePaths=-/run/systemd/resolve
InaccessiblePaths=-/run/dbus/system_bus_socket
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=tmpfs
BindReadOnlyPaths=%h/.local/opt/octoplus
BindReadOnlyPaths=-%h/.config/octoplus/config.toml
BindPaths=%h/.local/share/octoplus/soak
InaccessiblePaths=-/run/octoplus-fetcher/fetch
BindPaths=-/run/octoplus-fetcher/health
TemporaryFileSystem=%t/octoplus
BindPaths=%t/octoplus/healthd
BindPaths=%t/octoplus/monitor/health
BindPaths=%t/octoplus/voice/health
BindPaths=%t/octoplus/storage/health
BindPaths=%t/octoplus/inference/health
BindPaths=%t/octoplus/knowledge/health
BindPaths=%t/octoplus/kernel/health
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectClock=true
ProtectHostname=true
RestrictNamespaces=true
RestrictRealtime=true
RestrictSUIDSGID=true
RestrictAddressFamilies=AF_UNIX
LockPersonality=true
MemoryDenyWriteExecute=true
SystemCallArchitectures=native
SystemCallFilter=@system-service landlock_create_ruleset landlock_add_rule landlock_restrict_self
CapabilityBoundingSet=
AmbientCapabilities=
LimitCORE=0
UMask=0077
MemoryMax=32M
Restart=on-failure
RestartSec=2s
ExecStart=%h/.local/opt/octoplus/bin/octoplus-healthd

[Install]
WantedBy=octoplus.target
