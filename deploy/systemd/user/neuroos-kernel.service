[Unit]
Description=Semantic-NeuroOS Safety Kernel
PartOf=neuroos.target
Requires=neuroos-runtime.service
After=neuroos-runtime.service neuroos-healthd.service neuroos-storage.service neuroos-inference.service

[Service]
PrivateNetwork=true
InaccessiblePaths=-/run/systemd/resolve
InaccessiblePaths=-/run/dbus/system_bus_socket
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=tmpfs
BindReadOnlyPaths=%h/.local/opt/neuroos
BindReadOnlyPaths=-%h/.config/neuroos/config.toml
TemporaryFileSystem=/run/neuroos-fetcher
BindPaths=-/run/neuroos-fetcher/fetch
TemporaryFileSystem=%t/neuroos
BindPaths=%t/neuroos/kernel
BindPaths=%t/neuroos/monitor/control
BindPaths=%t/neuroos/voice/control
BindPaths=%t/neuroos/storage/storage
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectClock=true
ProtectHostname=true
RestrictNamespaces=true
RestrictRealtime=true
RestrictSUIDSGID=true
RestrictAddressFamilies=AF_UNIX
LockPersonality=true
MemoryDenyWriteExecute=true
SystemCallArchitectures=native
SystemCallFilter=@system-service landlock_create_ruleset landlock_add_rule landlock_restrict_self
CapabilityBoundingSet=
AmbientCapabilities=
LimitCORE=0
UMask=0077
MemoryMax=64M
Restart=on-failure
RestartSec=2s
ExecStart=%h/.local/opt/neuroos/bin/neuroos-kernel

[Install]
WantedBy=neuroos.target
