[Unit]
Description=Semantic-NeuroOS Voice Interface
PartOf=neuroos.target
Requires=neuroos-runtime.service
Wants=neuroos-tts.socket
After=neuroos-tts.socket neuroos-runtime.service neuroos-healthd.service neuroos-storage.service neuroos-inference.service neuroos-monitor.service neuroos-kernel.service neuroos-knowledge.service

[Service]
PrivateNetwork=true
InaccessiblePaths=-/run/systemd/resolve
InaccessiblePaths=-/run/dbus/system_bus_socket
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=tmpfs
BindReadOnlyPaths=%h/.local/opt/neuroos
BindReadOnlyPaths=-%h/.config/neuroos/config.toml
BindReadOnlyPaths=-%h/.config/neuroos/voice.conf
BindPaths=-%t/pipewire-0
InaccessiblePaths=-/run/neuroos-fetcher
TemporaryFileSystem=%t/neuroos
BindPaths=%t/neuroos/voice
BindPaths=%t/neuroos/knowledge/knowledge
# The speech helper's socket (config tts_engine = pocket, owner exception D-54): the one extra
# socket this part can reach; absent when the helper is not installed.
BindPaths=-%t/neuroos/tts
PrivateTmp=true
# C2: audio runs through the PipeWire socket in the runtime folder (no device files),
# so PrivateDevices stays on; only real-time scheduling is exempt (Architecture §8.1).
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectClock=true
ProtectHostname=true
RestrictNamespaces=true
RestrictSUIDSGID=true
RestrictAddressFamilies=AF_UNIX
LockPersonality=true
MemoryDenyWriteExecute=true
SystemCallArchitectures=native
SystemCallFilter=@system-service landlock_create_ruleset landlock_add_rule landlock_restrict_self
CapabilityBoundingSet=
AmbientCapabilities=
LimitCORE=0
UMask=0077
MemoryMax=960M
Restart=on-failure
RestartSec=2s
ExecStart=%h/.local/opt/neuroos/bin/neuroos-voice --socket %t/neuroos/voice/voice/voice.sock=neuroos-knowledge.service --socket %t/neuroos/voice/control/control.sock=uid --health-socket %t/neuroos/voice/health/health.sock=neuroos-healthd.service --models-dir %h/.local/opt/neuroos/models/voice --voice-config %h/.config/neuroos/voice.conf

[Install]
WantedBy=neuroos.target
