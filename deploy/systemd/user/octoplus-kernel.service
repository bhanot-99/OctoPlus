[Unit]
Description=OctoPlus Safety Kernel
PartOf=octoplus.target
Requires=octoplus-runtime.service
After=octoplus-runtime.service octoplus-healthd.service octoplus-storage.service octoplus-inference.service

[Service]
PrivateNetwork=true
InaccessiblePaths=-/run/systemd/resolve
InaccessiblePaths=-/run/dbus/system_bus_socket
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=tmpfs
BindReadOnlyPaths=%h/.local/opt/octoplus
BindReadOnlyPaths=-%h/.config/octoplus/config.toml
BindReadOnlyPaths=%h/.config/octoplus/hmac.key
BindReadOnlyPaths=-%h/.config/octoplus/fetch.key
BindPaths=%h/.local/share/octoplus/audit
BindPaths=-%t/wayland-0
BindPaths=-%t/wayland-1
BindPaths=-%t/bus
BindPaths=-%t/at-spi
BindPaths=-%h/.cache
BindPaths=-%h/.local/share/Trash
InaccessiblePaths=-/run/octoplus-fetcher/health
BindPaths=-/run/octoplus-fetcher/fetch
TemporaryFileSystem=%t/octoplus
BindPaths=%t/octoplus/kernel
BindPaths=%t/octoplus/monitor/control
BindPaths=%t/octoplus/voice/control
BindPaths=%t/octoplus/storage/storage
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectClock=true
ProtectHostname=true
RestrictNamespaces=true
RestrictRealtime=true
RestrictSUIDSGID=true
RestrictAddressFamilies=AF_UNIX
LockPersonality=true
MemoryDenyWriteExecute=true
SystemCallArchitectures=native
SystemCallFilter=@system-service landlock_create_ruleset landlock_add_rule landlock_restrict_self
SystemCallFilter=seccomp
CapabilityBoundingSet=
AmbientCapabilities=
LimitCORE=0
UMask=0077
MemoryMax=128M
Restart=on-failure
RestartSec=2s
ExecStart=%h/.local/opt/octoplus/bin/octoplus-kernel

[Install]
WantedBy=octoplus.target
