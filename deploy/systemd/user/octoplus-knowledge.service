[Unit]
Description=OctoPlus Knowledge and Nudge Engine
PartOf=octoplus.target
Requires=octoplus-runtime.service
After=octoplus-runtime.service octoplus-healthd.service octoplus-storage.service octoplus-inference.service octoplus-monitor.service octoplus-kernel.service

[Service]
PrivateNetwork=true
InaccessiblePaths=-/run/systemd/resolve
InaccessiblePaths=-/run/dbus/system_bus_socket
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=tmpfs
BindReadOnlyPaths=%h/.local/opt/octoplus
BindReadOnlyPaths=-%h/.config/octoplus/config.toml
BindReadOnlyPaths=-%h/.config/octoplus/nudges.toml
InaccessiblePaths=-/run/octoplus-fetcher
TemporaryFileSystem=%t/octoplus
BindPaths=%t/octoplus/knowledge
BindPaths=%t/octoplus/voice/voice
BindPaths=%t/octoplus/storage/storage
BindPaths=%t/octoplus/inference/inference
BindPaths=%t/octoplus/kernel/kernel
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectClock=true
ProtectHostname=true
RestrictNamespaces=true
RestrictRealtime=true
RestrictSUIDSGID=true
RestrictAddressFamilies=AF_UNIX
LockPersonality=true
MemoryDenyWriteExecute=true
SystemCallArchitectures=native
SystemCallFilter=@system-service landlock_create_ruleset landlock_add_rule landlock_restrict_self
CapabilityBoundingSet=
AmbientCapabilities=
LimitCORE=0
UMask=0077
MemoryMax=96M
Restart=on-failure
RestartSec=2s
ExecStart=%h/.local/opt/octoplus/bin/octoplus-knowledge

[Install]
WantedBy=octoplus.target
