[Unit]
Description=OctoPlus Runtime Directories
PartOf=octoplus.target

[Service]
Type=oneshot
RemainAfterExit=yes
PrivateNetwork=true
InaccessiblePaths=-/run/systemd/resolve
InaccessiblePaths=-/run/dbus/system_bus_socket
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=tmpfs
BindPaths=%t
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectClock=true
ProtectHostname=true
RestrictNamespaces=true
RestrictRealtime=true
RestrictSUIDSGID=true
RestrictAddressFamilies=AF_UNIX
LockPersonality=true
MemoryDenyWriteExecute=true
SystemCallArchitectures=native
SystemCallFilter=@system-service
CapabilityBoundingSet=
AmbientCapabilities=
LimitCORE=0
UMask=0077
ExecStart=/usr/bin/install -d -m 0700 %t/octoplus %t/octoplus/monitor %t/octoplus/voice %t/octoplus/storage %t/octoplus/inference %t/octoplus/knowledge %t/octoplus/kernel %t/octoplus/healthd %t/octoplus/monitor/stream %t/octoplus/monitor/control %t/octoplus/voice/voice %t/octoplus/voice/control %t/octoplus/storage/storage %t/octoplus/inference/inference %t/octoplus/knowledge/knowledge %t/octoplus/kernel/kernel %t/octoplus/healthd/healthd %t/octoplus/monitor/health %t/octoplus/voice/health %t/octoplus/storage/health %t/octoplus/inference/health %t/octoplus/knowledge/health %t/octoplus/kernel/health

[Install]
WantedBy=octoplus.target
